{
  "name": "argo-search",
  "version": "2.9.0",
  "description": "Argo 阿尔戈 — 统一搜索与证据核验。推荐 npx -y github:taxueseek/argo 或 install.sh 安装（不依赖 npm 发版）。多语言路由、255 个源（221 个免密钥开箱可用）、影视/体育/金融等垂直源、垂直结构化模态卡、19 个 MCP 工具（与 CLI 能力面对齐）。",
  "keywords": [
    "mcp",
    "mcp-server",
    "search",
    "web-search",
    "research",
    "ai-agent",
    "claude",
    "grok",
    "kimi",
    "codex",
    "argo",
    "npx"
  ],
  "private": true,
  "license": "MIT",
  "author": "Argo Search",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taxueseek/argo.git"
  },
  "bin": {
    "argo-search": "bin/argo.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "config.yaml",
    "engines/",
    "backends/",
    "data/",
    "sub-skills/",
    "assets/",
    "docs/",
    "cordis.patch.yml",
    "packages/dsh-plugin/",
    "README.md",
    "SKILL.md",
    "LICENSE",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!sub-skills/**/__pycache__/**",
    "!sub-skills/**/*.pyc",
    "!data/jobs"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {}
}
