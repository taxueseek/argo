#!/bin/sh
# argo-managed-hook v2（install.sh 调度器据此识别 argo 自产 hook，勿删本标记行）
# argo 提交前快门禁（pre-commit hook）。
#
# 为什么需要（2026-10-16 流程洞实证）：并发代理往主管线接线时没跑测试——
# 6 道门禁红 + 阻塞全量收集，故障在树里躺了幾小时才被人工发现。「改了没
# 验证就提交」没有机制拦截，只靠自觉。本 hook 把拦截点放在提交层。
#
# 只跑快的几道（实测合计 ~13s）：static_lint（语法/重复键/未声明 env）、
# module_size_gate（1000 行门禁与祖父登记）、usage_doc（ARGO_* 开关总表）、
# consistency（版本/徽章/工具数五语对账）、routing_snapshot（路由决策漂移）、
# context_budget + engine_catalog（常驻文档预算、源文档/死源/声明一致）、
# spec_contracts + stub_targets（2026-11-04 补的 B 类复发护栏：规格契约
# ——bilibili/xhs 缺 --json 同类根因；打桩目标存在性——重构后打桩落转出
# 副本的三例同类根因，实测合计 +0.7s）。
# env_binding（2026-11-06 补的第 3 道 B 类复发护栏：模块导入期直接读 env
# 一律红灯——290d3d8 同根因累计 9 处灭类后零祖父，AST 扫描 <0.5s）。
# dependency_source（2026-11-09 补：pyproject 是真源、requirements 是派生清单，
# 双向对账——清单里有真源没有的、真源里有 lock 没有的，都红。实测 <0.5s）。
# 状态词表四件套（2026-11-10 补）：test_engine_states（词表契约）、
# test_native_tools_sync（Python→JS 生成物漂移）、test_zcode_bridge_daemon_state
# （桥的 daemon 状态读字段）、test_state_literal_drift（AST 扫「已登记状态值
# 又退回去写成字面量」）。此前改 engine_states.py 不跑全量 pytest 就能提交，
# hook 与 CI 都没有这几道门；四者合计 <1s，放进 hook 不触发 --no-verify 绕过。
# 2026-10-18 补的两道（context_budget + engine_catalog）：f702ee2 把
# SKILL.md 压到 8049B、4a71693 让 deepseek_search 成死源，两笔都过了 hook
# 却在全量回归里红——正是「改完没跑到那条门」的同一个洞。全量回归 ~5 分钟
# 留给 CI 或手动（python3 -m pytest tests/ -q），不进 hook——hook 慢于 20s
# 就会被用户 --no-verify 绕过，那是更坏的结局。
# 2026-11-10 补的两道（test_intl_engines + test_image_sources）：d532486 把
# 7 个国际源与 cleveland 的专用 builder 归一为声明式 Spec 后，这两份用例
# 仍直接调用已删除的 _build_xxx_engine，实测 9 项 AttributeError——而它们
# 不在 hook 覆盖内，于是「门禁全绿 + 归一后解析路径零覆盖」并存。归一的
# 风险不在新代码本身，而在「旧契约测试没跟着改」。两者合计 <1s。
#
# 安装：bash scripts/install.sh 自动装调度器 hooks/pre-commit（原有 hook 改名
# pre-commit.user 先跑，再直接执行本文件，不拷贝）。手动跑：sh scripts/pre-commit
# 跳过（不推荐）：git commit --no-verify
set -e

# 仓库根：git 运行时 cwd 即工作树根；装在 hooks/ 下或被拷贝到别处时，
# 脚本相对推导会指向 .git 目录（2026-10-17 实测踩中），故以 show-toplevel
# 为准、脚本相对为兜底（原产地 scripts/ 形态手动跑也成立）。
root=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -z "$root" ] || [ ! -d "$root/tests" ]; then
    here=$(cd "$(dirname "$0")" && pwd)
    root=$(cd "$here/.." && pwd)
fi
cd "$root" || exit 1

# 解释器选择：uv 同步出的仓内 .venv 是唯一钉版档（.python-version 指定版本，
# uv.lock 钉依赖），首选它。此前是裸 `command -v python3`——2026-10-26 实测，
# 默认 PATH 的 python3 是 3.15（无 pytest），hook 每次提交都死在 pytest 收集
# 之前，拦截层形同虚设。此后候选链改到第 4 次仍在漂移（homebrew 升级清掉
# python3.14），根因是「候选链本身就是多个真源」。2026-11-09 收口：有 uv 且
# .venv 缺失时**当场同步**（uv sync --frozen --group dev，读 .python-version
# 与 uv.lock），不再靠 PATH 散装解释器回落；PATH 候选仅作为 uv 不可用时的
# 兜底，且顺序按「越新越优先」排——3.9 档也能跑（pytest 8.3.5 由 lock 解析）。
# 真 import 而非 find_spec：半装的 pytest、被 sitecustomize 顶掉的包都属
# 「说在其实不在」（见 bin/argo 严格档的同类教训）。候选全空时维持原口径
# fail closed，绝不静默放行。
PY=""
if [ -n "${ARGO_GATE_PYTHON:-}" ]; then
    PY="$ARGO_GATE_PYTHON"
fi
if [ -z "$PY" ] && [ -x .venv/bin/python ] && .venv/bin/python -c "import pytest, yaml" >/dev/null 2>&1; then
    PY=".venv/bin/python"
fi
if [ -z "$PY" ] && command -v uv >/dev/null 2>&1; then
    echo "[pre-commit] .venv 缺失或不可用，用 uv 按 uv.lock 同步…"
    if uv sync --frozen --group dev >/dev/null 2>&1 \
            && .venv/bin/python -c "import pytest, yaml" >/dev/null 2>&1; then
        PY=".venv/bin/python"
    fi
fi
if [ -z "$PY" ]; then
    for cand in python3.14 python3.13 python3.12 python3.11 python3.10 python3 python; do
        if command -v "$cand" >/dev/null 2>&1 \
                && "$cand" -c "import pytest, yaml" >/dev/null 2>&1; then
            PY=$cand
            break
        fi
    done
fi
if [ -z "$PY" ]; then
    echo "[pre-commit] 找不到带 pytest+yaml 的解释器（候选：\$ARGO_GATE_PYTHON、仓内 .venv、uv sync、python3.14/3.13/3.12/3.11/3.10、python3、python），门禁视为失败" >&2
    exit 1
fi

printf "[pre-commit] argo 快门禁（~13s，解释器 %s；全量回归请手动跑 tests/）...\n" "$PY"
"$PY" -m pytest -q \
    tests/test_static_lint_gate.py \
    tests/test_module_size_gate.py \
    tests/test_usage_doc_gates.py \
    tests/test_consistency_gates.py \
    tests/test_routing_snapshot.py \
    tests/test_context_budget.py \
    tests/test_engine_catalog.py \
    tests/test_release_consistency.py \
    tests/test_spec_contracts.py \
    tests/test_stub_targets.py \
    tests/test_env_binding_gate.py \
    tests/test_local_search_registry.py \
    tests/test_launch_passthrough_alignment.py \
    tests/test_dependency_source_gate.py \
    tests/test_install_script_contract.py \
    tests/test_deep_budget_tail_grace.py \
    tests/test_engine_states.py \
    tests/test_native_tools_sync.py \
    tests/test_zcode_bridge_daemon_state.py \
    tests/test_state_literal_drift.py \
    tests/test_check_commit_report.py \
    tests/test_badcase_ledger.py \
    tests/test_agents_routing.py \
    tests/test_intl_engines.py \
    tests/test_image_sources.py

# 派生件一致性门禁（P0-2）：写完 spec 不跑 sync 就提交，派生件会过期。
# 实测 0.13s，进 pre-commit 不触发 --no-verify 绕过。
echo "[pre-commit] 派生件一致性校验..."
if ! "$PY" scripts/sync_backends.py --check; then
    echo "[pre-commit] 派生件过期，请运行: python3 scripts/sync_backends.py" >&2
    exit 1
fi

if command -v node >/dev/null 2>&1 && [ -f packages/dsh-plugin/test/size-gate.test.js ]; then
    node --test packages/dsh-plugin/test/size-gate.test.js packages/dsh-plugin/test/client.test.js
fi

# 高风险提交的检查清单提示（2026-11-10）：只警告不硬拦。
# 为什么只警告：hook 慢于 20s 就会被 --no-verify 绕过，一道会被绕过的硬门
# 比没有门更坏（见本文件头 2026-10-18 的注释）。它只让「省略未跑检查」变可见。
#
# EDITMSG 的位置与时机：worktree 根目录或 git-common-dir（后者给 linked
# worktree）。**pre-commit 阶段该文件可能还是上一次提交的内容**——git 在 hook
# 跑完后才把新信息写进去。所以这里比对文件内容与 HEAD 的提交信息：相同就说明
# 读到的是旧稿，跳过本次提示（不是每个提交都需要它，为它把提交卡住本末倒置）。
_editmsg=""
_git_common=$(git rev-parse --git-common-dir 2>/dev/null || true)
for _cand in "$root/COMMIT_EDITMSG" "$_git_common/COMMIT_EDITMSG"; do
    case "$_cand" in
        */COMMIT_EDITMSG) [ -f "$_cand" ] && { _editmsg="$_cand"; break; } ;;
    esac
done
if [ -n "$_editmsg" ]; then
    _head_subject=$(git log -1 --format=%s HEAD 2>/dev/null || true)
    _draft_subject=$(grep -v '^#' "$_editmsg" 2>/dev/null | grep -v '^[[:space:]]*$' | head -1 || true)
    if [ -n "$_draft_subject" ] && [ "$_draft_subject" != "$_head_subject" ]; then
        "$PY" scripts/check_commit_report.py --message-file "$_editmsg" || true
    fi
fi
