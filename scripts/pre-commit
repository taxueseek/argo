#!/bin/sh
# argo-managed-hook v2（install.sh 调度器据此识别 argo 自产 hook，勿删本标记行）
# argo 提交前快门禁（pre-commit hook）。
#
# 为什么需要（2026-10-16 流程洞实证）：并发代理往主管线接线时没跑测试——
# 6 道门禁红 + 阻塞全量收集，故障在树里躺了幾小时才被人工发现。「改了没
# 验证就提交」没有机制拦截，只靠自觉。本 hook 把拦截点放在提交层。
#
# 只跑快的几道（2026-11-13 实测合计 17.4s：500 用例无单一贵项，最贵
# static_lint 单用例 1.7s，属广度成本、无挪项空间）：static_lint（语法/重复键/未声明 env）、
# module_size_gate（1000 行门禁与祖父登记）、usage_doc（ARGO_* 开关总表）、
# consistency（版本/徽章/工具数五语对账）、routing_snapshot（路由决策漂移）、
# context_budget + engine_catalog（常驻文档预算、源文档/死源/声明一致）、
# spec_contracts + stub_targets（2026-11-04 补的 B 类复发护栏：规格契约
# ——bilibili/xhs 缺 --json 同类根因；打桩目标存在性——重构后打桩落转出
# 副本的三例同类根因，实测合计 +0.7s）。
# env_binding（2026-11-06 补的第 3 道 B 类复发护栏：模块导入期直接读 env
# 一律红灯——290d3d8 同根因累计 9 处灭类后零祖父，AST 扫描 <0.5s）。
# dependency_source（2026-11-09 补：pyproject 是真源、requirements 是派生清单，
# 双向对账——清单里有真源没有的、真源里有 lock 没有的，都红。实测 <0.5s）。
# 状态词表三件套（2026-11-10 补；2026-11-13 桥随 ZCode 插件剥离退出为三）：
# test_engine_states（词表契约）、test_native_tools_sync（Python→JS 生成物漂移）、
# test_state_literal_drift（AST 扫「已登记状态值
# 又退回去写成字面量」）。此前改 engine_states.py 不跑全量 pytest 就能提交，
# hook 与 CI 都没有这几道门；四者合计 <1s，放进 hook 不触发 --no-verify 绕过。
# 2026-10-18 补的两道（context_budget + engine_catalog）：f702ee2 把
# SKILL.md 压到 8049B、4a71693 让 deepseek_search 成死源，两笔都过了 hook
# 却在全量回归里红——正是「改完没跑到那条门」的同一个洞。全量回归 ~5 分钟
# 留给 CI 或手动（python3 -m pytest tests/ -q），不进 hook——hook 慢于 20s
# 就会被用户 --no-verify 绕过，那是更坏的结局。
# 2026-11-10 补的两道（test_intl_engines + test_image_sources）：d532486 把
# 7 个国际源与 cleveland 的专用 builder 归一为声明式 Spec 后，这两份用例
# 仍直接调用已删除的 _build_xxx_engine，实测 9 项 AttributeError——而它们
# 不在 hook 覆盖内，于是「门禁全绿 + 归一后解析路径零覆盖」并存。归一的
# 风险不在新代码本身，而在「旧契约测试没跟着改」。两者合计 <1s。
# 2026-11-11 补的七道（mcp_schema_maas_compliance / mcp_consolidated_tools /
# redactor_guard / semantic_evidence_jev / schema_drift_diagnosis /
# smart_inference / local_intent / mcp_article_job）：这七份是 11-10 至 11-11
# 那批「还债」提交新写的用例，覆盖了 MCP 工具面收敛、MaaS 兼容净化接线、
# 输出脱敏、JEV 语义层、解析器漂移诊断、智能推断与本地意图判据——全部不在
# hook 覆盖内，于是那批改动里「新增能力零门禁」与「修了正确性缺陷」并存。
# 八者合计 <2s（实测 0.6s），放进 hook 不触发 --no-verify 绕过。
# 2026-11-12 补的一道（test_silent_catch_gate）：评审抓到 mcp_handlers._ok
# 脱敏吞异常——全仓唯一「吞异常产生可利用后果」的实例，已改 fail-closed。
# 同根因其余宽口径裸吞走 GRANDFATHERED 棘轮门禁（except Exception+
# 裸 pass/continue 只准减不准增，AST 扫 <0.3s），窄化一处同步下调基线；
# 2026-11-13 证据管线首批收口 24 处（187→162），余量集中在 cache/sqlite
# 读写点（OperationalError 不在词汇表，见 badcase_ledger 基线注释）。
# 同批把 static_lint 五处重复全仓 ast.parse 收进会话级缓存、本文件与
# AGENTS.md 的「~13s」漂移注释修为实测值：hook 实测 20.8s（已超自设 20s
# 红线）回到 ~17s，新门禁是在这个余量里加的。
# 2026-11-14 清单单真源收口：42 文件手工枚举迁到 tests/gate_manifest.txt
# （49 条：42 + env/config 对账门补册 6 + 本门禁自身 1），漏册由
# test_gate_manifest.py 反向断言拦截，本文件不再随新门禁逐轮追加。
# 2026-11-21 根因修复：13 项 skip 豁免全部入册（实测均 <1s），清单 73 条；
# 串行实测 19.2~21.5s 已跨 20s 红线，故改 4 片并行（墙钟 ~8s，824 用例
# 零丢失）。取消 skip 层的原因：豁免项只由 CI 兜底，而本地连续 36 笔未推、
# CI 零覆盖，两次「本地绿、全量红」由此漏库（test_http_attribution、
# test_subprocess_encoding_gate）。拦截点必须留在本地。
#
# 安装：bash scripts/install.sh 自动装调度器 hooks/pre-commit（原有 hook 改名
# pre-commit.user 先跑，再直接执行本文件，不拷贝）。手动跑：sh scripts/pre-commit
# 跳过（不推荐）：git commit --no-verify
set -e

# 仓库根：git 运行时 cwd 即工作树根；装在 hooks/ 下或被拷贝到别处时，
# 脚本相对推导会指向 .git 目录（2026-10-17 实测踩中），故以 show-toplevel
# 为准、脚本相对为兜底（原产地 scripts/ 形态手动跑也成立）。
root=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -z "$root" ] || [ ! -d "$root/tests" ]; then
    here=$(cd "$(dirname "$0")" && pwd)
    root=$(cd "$here/.." && pwd)
fi
cd "$root" || exit 1

# 解释器选择：uv 同步出的仓内 .venv 是唯一钉版档（.python-version 指定版本，
# uv.lock 钉依赖），首选它。此前是裸 `command -v python3`——2026-10-26 实测，
# 默认 PATH 的 python3 是 3.15（无 pytest），hook 每次提交都死在 pytest 收集
# 之前，拦截层形同虚设。此后候选链改到第 4 次仍在漂移（homebrew 升级清掉
# python3.14），根因是「候选链本身就是多个真源」。2026-11-09 收口：有 uv 且
# .venv 缺失时**当场同步**（uv sync --frozen --group dev，读 .python-version
# 与 uv.lock），不再靠 PATH 散装解释器回落；PATH 候选仅作为 uv 不可用时的
# 兜底，且顺序按「越新越优先」排——3.9 档也能跑（pytest 8.3.5 由 lock 解析）。
# 真 import 而非 find_spec：半装的 pytest、被 sitecustomize 顶掉的包都属
# 「说在其实不在」（见 bin/argo 严格档的同类教训）。候选全空时维持原口径
# fail closed，绝不静默放行。
PY=""
if [ -n "${ARGO_GATE_PYTHON:-}" ]; then
    _probe_out=$("$ARGO_GATE_PYTHON" -c "import pytest, yaml; print('ARGO_PY_OK')" 2>/dev/null || true)
    if [ "$_probe_out" != "ARGO_PY_OK" ]; then
        echo "[pre-commit] ARGO_GATE_PYTHON=${ARGO_GATE_PYTHON} 不可用或缺少 pytest/yaml，拒绝静默放行" >&2
        exit 1
    fi
    PY="$ARGO_GATE_PYTHON"
fi
if [ -z "$PY" ] && [ -x .venv/bin/python ] && .venv/bin/python -c "import pytest, yaml" >/dev/null 2>&1; then
    PY=".venv/bin/python"
fi
if [ -z "$PY" ] && command -v uv >/dev/null 2>&1; then
    echo "[pre-commit] .venv 缺失或不可用，用 uv 按 uv.lock 同步…"
    if uv sync --frozen --group dev >/dev/null 2>&1 \
            && .venv/bin/python -c "import pytest, yaml" >/dev/null 2>&1; then
        PY=".venv/bin/python"
    fi
fi
if [ -z "$PY" ]; then
    for cand in python3.14 python3.13 python3.12 python3.11 python3.10 python3 python; do
        if command -v "$cand" >/dev/null 2>&1 \
                && "$cand" -c "import pytest, yaml" >/dev/null 2>&1; then
            PY=$cand
            break
        fi
    done
fi
if [ -z "$PY" ]; then
    echo "[pre-commit] 找不到带 pytest+yaml 的解释器（候选：\$ARGO_GATE_PYTHON、仓内 .venv、uv sync、python3.14/3.13/3.12/3.11/3.10、python3、python），门禁视为失败" >&2
    exit 1
fi

# 测试清单单真源：tests/gate_manifest.txt（2026-11-14 收口）。
# 清单曾在此手工枚举 42 个文件，每轮新门禁「漏一道加一道」（头注释史
# 至少 6 轮），env/config 对账门三道长期漏册——现由 tests/test_gate_manifest.py
# 反向断言兜住：门禁命名类（gate/consistency/drift/snapshot/registry/
# contract/sync/lint）必须入册或在 manifest 登记 skip 豁免（带理由）。
# 新门禁只改 manifest 一行，hook 本文件不再动。manifest 缺失 fail-closed，
# 绝不静默放行（与解释器选择同纪律）。
MANIFEST="tests/gate_manifest.txt"
if [ ! -f "$MANIFEST" ]; then
    echo "[pre-commit] 缺 $MANIFEST，快门禁清单无真源，门禁视为失败" >&2
    exit 1
fi
# 条数从清单真源现算（2026-11-24）：这里是手抄数字的第三个副本，manifest 从
# 74 涨到 76 时不会变红——AGENTS.md 有 test_agents_md_precommit_file_count_matches
# 对拍，本行没有。打印值与实际跑的分片内容不一致会误导「跑了多少道门」的判断。
GATE_COUNT=$(grep -Ev '(^[[:space:]]*#|^[[:space:]]*$)' "$MANIFEST" | wc -l | tr -d ' ')
printf "[pre-commit] argo 快门禁（%s 条 4 片并行，实测 ~8s，解释器 %s；全量回归请手动跑 tests/）...\n" "$GATE_COUNT" "$PY"
# 新增测试文件当场归类（2026-11-21 审计）：test_gate_manifest.py 的词根
# 反向断言拦不住命名不带 gate/… 的 <1s 文件（两个漏册实证），本检查把
# 拦截点前移到 commit 时刻——staged 新增 tests/test_*.py 必须入册；存量
# 未登记文件不受影响。实测 <0.2s。
"$PY" scripts/gate_manifest_check.py

# 快门禁分片并行（2026-11-21 根因修复）。
#
# 为什么必须并行：清单是全量收录（skip 豁免层已取消），串行实测 19.2~21.5s，
# 波动跨过自设 20s 红线——而「慢于 20s 就会被 --no-verify 绕过」正是这份
# 清单当初把 13 道门豁免给 CI 的原因。豁免的代价已实证两次：本地连续 36 笔
# 未推、CI 零覆盖，test_http_attribution 与 test_subprocess_encoding_gate
# 两次「本地绿、全量红」漏进库。所以正解不是把门挪走，而是让本地跑得起：
# 4 片并行墙钟 ~8s（实测两轮 7.88/7.77s，824 用例零丢失、4 片全 rc=0）。
#
# 分片插件与 CI 同源（pytest-split + tests/.test_durations），保证本地与
# CI 看到同一份清单。pytest-split 缺失时回落串行并显式告警——不静默跳过。
GATE_SPLITS=4
if ! "$PY" -c "import pytest_split" >/dev/null 2>&1; then
    echo "[pre-commit] 警告：缺 pytest-split，快门禁回落串行（本地与 CI 清单仍一致，只是慢）" >&2
    "$PY" -m pytest -q -p no:cacheprovider $(grep -Ev '(^[[:space:]]*#|^[[:space:]]*$)' "$MANIFEST")
else
    pids=""; failed=0
    for g in $(seq 1 "$GATE_SPLITS"); do
        "$PY" -m pytest -q -p no:cacheprovider \
            --splits "$GATE_SPLITS" --group "$g" \
            --durations-path tests/.test_durations \
            $(grep -Ev '(^[[:space:]]*#|^[[:space:]]*$)' "$MANIFEST") &
        pids="$pids $!"
    done
    for p in $pids; do
        wait "$p" || failed=1
    done
    if [ "$failed" -ne 0 ]; then
        echo "[pre-commit] 快门禁有分片失败（见上方输出）" >&2
        exit 1
    fi
fi

# L2 变更感知增量选测（2026-11-24 方案三）：按 staged 改动反查未入册的 343 个
# 存量单测并在 8s 预算内精准执行，补齐「本地绿、全量红」盲区；无命中 <0.25s。
"$PY" scripts/affected_tests.py --staged --run --budget 8

# 派生件一致性门禁（P0-2）：写完 spec 不跑 sync 就提交，派生件会过期。
# 实测 0.13s，进 pre-commit 不触发 --no-verify 绕过。
echo "[pre-commit] 派生件一致性校验与自愈同步..."
if ! "$PY" scripts/sync_backends.py --check; then
    echo "[pre-commit] 派生件过期，正在自动执行同步刷新..."
    "$PY" scripts/sync_backends.py
    "$PY" scripts/gen_engine_catalog.py
    echo "[pre-commit] 派生件已自动刷新，请检查并暂存相关修改: git add backends/ docs/ENGINE_CATALOG.md" >&2
    # 这里必须 exit 1，不能刷新后放行：钩子改的是工作区，暂存区里仍是旧版
    # 派生件；若返回 0，git 会把旧内容提交进去，校验反而形同虚设。也不自动
    # git add——把「刷新了什么」留给用户过目。
    exit 1
fi

# 子技能快门禁（2026-11-21 方案 B 补盲）：ego-search 回归测试耗时 <1s，
# 纳入本地快门禁消除子技能门禁真空带。
if [ -d sub-skills/ego-search/tests ]; then
    "$PY" -m pytest -q -p no:cacheprovider sub-skills/ego-search/tests
fi

# DSH 插件全量 Node 测试（2026-11-21 方案 B 补盲）：含 workbench / concurrency /
# client / index / diagnostics / config / size-gate，136 用例实测 ~2.5s。
if command -v node >/dev/null 2>&1 && [ -d packages/dsh-plugin/test ]; then
    node --test packages/dsh-plugin/test/*.test.js
fi

# 高风险提交的检查清单提示（2026-11-10）：只警告不硬拦。
# 为什么只警告：hook 慢于 20s 就会被 --no-verify 绕过，一道会被绕过的硬门
# 比没有门更坏（见本文件头 2026-10-18 的注释）。它只让「省略未跑检查」变可见。
#
# EDITMSG 的位置与时机：worktree 根目录或 git-common-dir（后者给 linked
# worktree）。**pre-commit 阶段该文件可能还是上一次提交的内容**——git 在 hook
# 跑完后才把新信息写进去。所以这里比对文件内容与 HEAD 的提交信息：相同就说明
# 读到的是旧稿，跳过本次提示（不是每个提交都需要它，为它把提交卡住本末倒置）。
_editmsg=""
_git_common=$(git rev-parse --git-common-dir 2>/dev/null || true)
for _cand in "$root/COMMIT_EDITMSG" "$_git_common/COMMIT_EDITMSG"; do
    case "$_cand" in
        */COMMIT_EDITMSG) [ -f "$_cand" ] && { _editmsg="$_cand"; break; } ;;
    esac
done
if [ -n "$_editmsg" ]; then
    _head_subject=$(git log -1 --format=%s HEAD 2>/dev/null || true)
    _draft_subject=$(grep -v '^#' "$_editmsg" 2>/dev/null | grep -v '^[[:space:]]*$' | head -1 || true)
    if [ -n "$_draft_subject" ] && [ "$_draft_subject" != "$_head_subject" ]; then
        "$PY" scripts/check_commit_report.py --message-file "$_editmsg" || true
    fi
fi
