{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "/argo/*": ["./dsh/*"]
    }
  },
  "include": [
    "dsh/**/*.js",
    "dsh/**/*.mjs",
    "types/**/*.d.ts"
  ]
}
